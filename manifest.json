{
  "manifest_version": 3,
  "name": "LinkedIn Message Link Collector",
  "version": "3.0.0",
  "description": "Find LinkedIn posts by keyword and append unique links to a Google Doc.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "windows"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://docs.google.com/document/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkedIn Link Collector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content-docs.js"],
      "run_at": "document_idle"
    }
  ]
}